<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ORM Command · Daily Check</title>
<style>
  :root{
    --bg:#0e1116;
    --panel:#161b22;
    --panel-2:#1c232d;
    --line:#2a323d;
    --ink:#e6edf3;
    --ink-dim:#8b98a5;
    --pos:#2ea043;
    --neu:#c9a227;
    --neg:#e5484d;
    --accent:#4c8dff;
    --shadow:0 18px 40px rgba(0,0,0,.55);
    --radius:18px;
  }
  *{box-sizing:border-box}
  body{
    margin:0;
    background:
      radial-gradient(1200px 600px at 80% -10%, rgba(76,141,255,.10), transparent 60%),
      var(--bg);
    color:var(--ink);
    font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
  }

  /* ---------- Top bar: 4 dashboard buttons ---------- */
  header{
    display:flex;align-items:center;gap:18px;
    padding:16px 22px;
    border-bottom:1px solid var(--line);
    background:rgba(14,17,22,.7);
    backdrop-filter:blur(8px);
    position:sticky;top:0;z-index:20;
    flex-wrap:wrap;
  }
  .brand{
    font-weight:800;letter-spacing:-.02em;font-size:18px;
    display:flex;align-items:center;gap:10px;white-space:nowrap;
  }
  .brand .dot{width:10px;height:10px;border-radius:50%;background:var(--accent);box-shadow:0 0 14px var(--accent)}
  nav{display:flex;gap:10px;flex-wrap:wrap;margin-left:auto}
  nav a{
    text-decoration:none;color:var(--ink);
    background:var(--panel);border:1px solid var(--line);
    padding:10px 16px;border-radius:12px;font-weight:600;font-size:14px;
    transition:.15s;display:flex;align-items:center;gap:8px;
  }
  nav a:hover{border-color:var(--accent);transform:translateY(-1px);background:var(--panel-2)}
  nav a .tag{font-size:11px;color:var(--ink-dim);font-weight:500}
  nav a.main{border-color:var(--accent);box-shadow:0 0 0 1px rgba(76,141,255,.25) inset}

  /* ---------- Daily check ---------- */
  main{max-width:1080px;margin:0 auto;padding:34px 22px 80px}
  .head-row{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:8px}
  h1{font-size:26px;margin:0;letter-spacing:-.02em}
  .sub{color:var(--ink-dim);font-size:14px;margin:6px 0 0}

  .stats{display:flex;gap:10px}
  .stat{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:10px 14px;text-align:center;min-width:70px}
  .stat b{display:block;font-size:20px}
  .stat span{font-size:11px;color:var(--ink-dim);text-transform:uppercase;letter-spacing:.05em}

  .stage{position:relative;height:460px;margin:34px auto 0;max-width:520px}
  .empty{
    height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;
    border:1px dashed var(--line);border-radius:var(--radius);color:var(--ink-dim);text-align:center;gap:8px;
  }
  .empty b{color:var(--ink);font-size:18px}

  .card{
    position:absolute;inset:0;background:var(--panel);
    border:1px solid var(--line);border-radius:var(--radius);
    box-shadow:var(--shadow);padding:26px;display:flex;flex-direction:column;
    transition:transform .35s cubic-bezier(.2,.8,.2,1), opacity .35s;
    user-select:none;
  }
  .card .meta{display:flex;align-items:center;gap:10px;margin-bottom:14px}
  .avatar{width:40px;height:40px;border-radius:10px;display:grid;place-items:center;font-weight:800;font-size:15px;color:#fff}
  .who{line-height:1.2}
  .who b{font-size:15px}
  .who span{font-size:12px;color:var(--ink-dim)}
  .badges{margin-left:auto;display:flex;gap:6px}
  .badge{font-size:11px;padding:4px 9px;border-radius:999px;border:1px solid var(--line);color:var(--ink-dim);font-weight:600}
  .badge.amb{color:var(--neu);border-color:rgba(201,162,39,.4);background:rgba(201,162,39,.08)}
  .badge.neg{color:var(--neg);border-color:rgba(229,72,77,.4);background:rgba(229,72,77,.08)}

  .text{font-size:17px;line-height:1.55;flex:1;overflow:auto;padding-right:4px}
  .src{margin-top:16px;display:flex;justify-content:space-between;color:var(--ink-dim);font-size:12px;border-top:1px solid var(--line);padding-top:12px}

  /* fling animations */
  .card.gone-up{transform:translateY(-120%) rotate(-4deg);opacity:0}
  .card.gone-down{transform:translateY(120%) rotate(4deg);opacity:0}
  .card.gone-right{transform:translateX(120%) rotate(8deg);opacity:0}
  .card.gone-left{transform:translateX(-120%) rotate(-8deg);opacity:0}

  /* directional glow hint overlay */
  .hint{position:absolute;font-weight:800;font-size:13px;letter-spacing:.08em;text-transform:uppercase;padding:6px 12px;border-radius:999px;opacity:0;transition:.15s}
  .hint.up{top:14px;left:50%;transform:translateX(-50%);color:var(--pos);background:rgba(46,160,67,.12);border:1px solid var(--pos)}
  .hint.down{bottom:14px;left:50%;transform:translateX(-50%);color:var(--neg);background:rgba(229,72,77,.12);border:1px solid var(--neg)}
  .hint.right{top:50%;right:14px;transform:translateY(-50%);color:var(--neu);background:rgba(201,162,39,.12);border:1px solid var(--neu)}

  /* ---------- controls legend ---------- */
  .legend{display:flex;gap:12px;justify-content:center;margin-top:26px;flex-wrap:wrap}
  .key{display:flex;align-items:center;gap:9px;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:9px 14px;font-size:13px;cursor:pointer;transition:.15s}
  .key:hover{border-color:var(--accent);background:var(--panel-2)}
  .kbd{min-width:26px;height:26px;display:grid;place-items:center;border-radius:7px;background:var(--panel-2);border:1px solid var(--line);font-size:13px}
  .key.pos .kbd{color:var(--pos)} .key.neg .kbd{color:var(--neg)} .key.neu .kbd{color:var(--neu)}

  /* ---------- modal ---------- */
  .overlay{position:fixed;inset:0;background:rgba(4,7,11,.7);backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;z-index:40;padding:20px}
  .overlay.on{display:flex}
  .modal{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);width:100%;max-width:480px;padding:24px;box-shadow:var(--shadow)}
  .modal h3{margin:0 0 4px;font-size:19px;display:flex;align-items:center;gap:9px}
  .modal .quote{background:var(--panel-2);border-left:3px solid var(--neg);padding:11px 14px;border-radius:8px;font-size:14px;color:var(--ink-dim);margin:14px 0}
  .modal label{font-size:13px;color:var(--ink-dim);font-weight:600;display:block;margin-bottom:7px}
  textarea{width:100%;min-height:110px;background:var(--bg);border:1px solid var(--line);border-radius:10px;color:var(--ink);padding:12px;font-family:inherit;font-size:14px;resize:vertical}
  textarea:focus{outline:none;border-color:var(--accent)}
  .modal-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:16px}
  button{font-family:inherit;font-weight:600;font-size:14px;border-radius:10px;padding:10px 18px;cursor:pointer;border:1px solid var(--line);background:var(--panel-2);color:var(--ink);transition:.15s}
  button:hover{border-color:var(--accent)}
  button.primary{background:var(--neg);border-color:var(--neg);color:#fff}
  button.primary:hover{filter:brightness(1.1)}
  .slack-note{font-size:12px;color:var(--ink-dim);display:flex;align-items:center;gap:6px;margin-top:2px}

  /* toast */
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--panel-2);border:1px solid var(--line);padding:12px 18px;border-radius:12px;font-size:14px;box-shadow:var(--shadow);opacity:0;transition:.3s;z-index:50;display:flex;align-items:center;gap:9px}
  .toast.show{transform:translateX(-50%) translateY(0);opacity:1}
  .toast .swatch{width:9px;height:9px;border-radius:50%}
</style>
</head>
<body>

<header>
  <div class="brand"><span class="dot"></span>ORM Command</div>
  <nav>
    <a class="main" href="https://main-dashboard.pages.dev/" target="_blank">Main Dashboard <span class="tag">SERM/SMM</span></a>
    <a href="https://gp-dash.pages.dev/" target="_blank">Google Play <span class="tag">Ratings</span></a>
    <a href="https://trust-pilot-dashboard.pages.dev/" target="_blank">Trustpilot <span class="tag">Intelligence</span></a>
    <a href="https://serm-bsw.pages.dev/" target="_blank">SERM BSW</a>
  </nav>
</header>

<main>
  <div class="head-row">
    <div>
      <h1>Daily Check</h1>
      <p class="sub">Mentions Gemini couldn't confidently score. Correct the sentiment to clear the queue.</p>
    </div>
    <div class="stats">
      <div class="stat"><b id="remaining">0</b><span>Left</span></div>
      <div class="stat"><b id="done">0</b><span>Done</span></div>
    </div>
  </div>

  <div class="stage" id="stage"></div>

  <div class="legend">
    <div class="key pos" data-act="up"><span class="kbd">↑</span> Positive</div>
    <div class="key neu" data-act="right"><span class="kbd">→</span> Neutral</div>
    <div class="key neg" data-act="down"><span class="kbd">↓</span> Negative + action</div>
    <div class="key" data-act="left"><span class="kbd">←</span> Undo</div>
  </div>
</main>

<!-- Negative action modal -->
<div class="overlay" id="overlay">
  <div class="modal">
    <h3>⚠️ Log negative mention</h3>
    <div class="slack-note">↳ Sent to <b>#orm-negatives</b> on Slack after submit</div>
    <div class="quote" id="modalQuote"></div>
    <label for="actionText">What action will be taken?</label>
    <textarea id="actionText" placeholder="e.g. Escalated to support, DM'd the user, flagged for legal review…"></textarea>
    <div class="modal-actions">
      <button id="cancelBtn">Cancel</button>
      <button class="primary" id="sendBtn">Mark negative &amp; send to Slack</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"><span class="swatch"></span><span id="toastMsg"></span></div>

<script>
/* ============================================================
   PROTOTYPE DATA
   In production, replace loadMentions() with a fetch to your
   Apps Script Web App (JSONP, per your Trustpilot dash pattern)
   returning rows where Gemini sentiment ∈ {negative, ambiguous}.
   ============================================================ */
const BRAND_COLORS = {
  "IQ Option":"#2b7de9","Exnova":"#7b5cff","Casatrade":"#0f9d7b","IQ Broker":"#e5843d"
};

function loadMentions(){
  return [
    {id:"m1",brand:"IQ Option",author:"trader_marco",source:"Trustpilot",gemini:"ambiguous",
     text:"Withdrawal took 3 days which was slower than expected, but support did eventually sort it out and the platform itself is smooth."},
    {id:"m2",brand:"Exnova",author:"@luisa.fx",source:"Instagram",gemini:"negative",
     text:"App keeps freezing on the login screen since the last update. Can't even get in to trade. Fix this."},
    {id:"m3",brand:"Casatrade",author:"reviewer_88",source:"Google Play",gemini:"ambiguous",
     text:"Not bad, not great. Does what it says. Fees are a bit high compared to others I've used."},
    {id:"m4",brand:"IQ Broker",author:"anon_user",source:"Facebook",gemini:"ambiguous",
     text:"Is this a scam? A friend recommended it but I'm seeing mixed things online. Genuinely asking before I deposit."},
    {id:"m5",brand:"IQ Option",author:"maria_p",source:"Trustpilot",gemini:"negative",
     text:"Verification has been pending for two weeks with no reply to my emails. Very frustrating experience so far."},
    {id:"m6",brand:"Exnova",author:"@daytrade_ben",source:"Twitter/X",gemini:"ambiguous",
     text:"Interface looks clean but I wish there were more indicators. Might stick around to see how it develops."}
  ];
}

/* ============================================================
   PRODUCTION HOOKS (stubbed for prototype)
   ============================================================ */
async function saveCorrection(mention, newSentiment){
  // TODO: POST to Apps Script Web App -> write sentiment back to the sheet row by id.
  console.log("[SHEET] set", mention.id, "->", newSentiment);
}
async function sendToSlack(mention, actionText){
  // TODO: POST to your Make.com webhook / Slack Incoming Webhook.
  console.log("[SLACK] #orm-negatives", {id:mention.id, brand:mention.brand, action:actionText});
}

/* ============================================================
   STATE + RENDER
   ============================================================ */
let queue = loadMentions();
let index = 0;
let done = 0;
const history = []; // {mentionIndex, prevDone} for undo

const stage = document.getElementById('stage');
const overlay = document.getElementById('overlay');
const actionText = document.getElementById('actionText');
const modalQuote = document.getElementById('modalQuote');

function initials(name){return name.replace(/[@_.]/g,' ').trim().split(/\s+/).map(w=>w[0]).join('').slice(0,2).toUpperCase();}

function updateStats(){
  document.getElementById('remaining').textContent = Math.max(queue.length - index, 0);
  document.getElementById('done').textContent = done;
}

function render(){
  updateStats();
  stage.innerHTML = '';
  if(index >= queue.length){
    stage.innerHTML = `<div class="empty"><b>Queue cleared 🎉</b><span>No more ambiguous or negative mentions to review right now.</span></div>`;
    return;
  }
  // render current + next (for depth)
  for(let i = Math.min(index+1, queue.length-1); i >= index; i--){
    const m = queue[i];
    const isTop = (i === index);
    const card = document.createElement('div');
    card.className = 'card';
    if(!isTop) card.style.transform = 'scale(.96) translateY(10px)';
    card.style.zIndex = 10 - (i-index);
    card.innerHTML = `
      <span class="hint up">↑ Positive</span>
      <span class="hint down">↓ Negative</span>
      <span class="hint right">→ Neutral</span>
      <div class="meta">
        <div class="avatar" style="background:${BRAND_COLORS[m.brand]}">${initials(m.author)}</div>
        <div class="who"><b>${m.author}</b><br><span>${m.brand}</span></div>
        <div class="badges">
          <span class="badge ${m.gemini==='negative'?'neg':'amb'}">${m.gemini==='negative'?'flagged negative':'ambiguous'}</span>
        </div>
      </div>
      <div class="text">"${m.text}"</div>
      <div class="src"><span>Source · ${m.source}</span><span>#${m.id}</span></div>`;
    stage.appendChild(card);
  }
}

function topCard(){return stage.querySelector('.card:last-child');}

function showToast(msg,color){
  const t = document.getElementById('toast');
  document.getElementById('toastMsg').textContent = msg;
  t.querySelector('.swatch').style.background = color;
  t.classList.add('show');
  clearTimeout(t._t); t._t = setTimeout(()=>t.classList.remove('show'),1800);
}

function advance(sentiment, dir, colorName){
  const m = queue[index];
  const card = topCard();
  if(!card) return;
  saveCorrection(m, sentiment);
  history.push({idx:index});
  card.classList.add('gone-'+dir);
  const color = sentiment==='positive'?getCSS('--pos'):sentiment==='neutral'?getCSS('--neu'):getCSS('--neg');
  showToast(`${m.brand} → ${colorName}`, color);
  index++; done++;
  setTimeout(render, 320);
}
function getCSS(v){return getComputedStyle(document.documentElement).getPropertyValue(v).trim();}

function undo(){
  if(!history.length || overlay.classList.contains('on')) return;
  const last = history.pop();
  index = last.idx; done = Math.max(done-1,0);
  render();
  const card = topCard();
  if(card){card.classList.add('gone-left');requestAnimationFrame(()=>{card.classList.remove('gone-left');});}
  showToast('Reverted last card', getCSS('--accent'));
}

/* ---- negative flow with modal ---- */
function openNegative(){
  if(index >= queue.length) return;
  const m = queue[index];
  modalQuote.textContent = `"${m.text}"`;
  actionText.value = '';
  overlay.classList.add('on');
  setTimeout(()=>actionText.focus(),50);
}
document.getElementById('cancelBtn').onclick = ()=>overlay.classList.remove('on');
document.getElementById('sendBtn').onclick = async ()=>{
  const m = queue[index];
  const txt = actionText.value.trim();
  if(!txt){actionText.style.borderColor=getCSS('--neg');return;}
  await sendToSlack(m, txt);
  overlay.classList.remove('on');
  advance('negative','down','Negative → Slack ✓');
};

/* ---- keyboard: the core "tinder" controls ---- */
document.addEventListener('keydown', e=>{
  if(overlay.classList.contains('on')){
    if(e.key==='Escape') overlay.classList.remove('on');
    if(e.key==='Enter' && (e.metaKey||e.ctrlKey)) document.getElementById('sendBtn').click();
    return;
  }
  switch(e.key){
    case 'ArrowUp':    e.preventDefault(); advance('positive','up','Positive'); break;
    case 'ArrowRight': e.preventDefault(); advance('neutral','right','Neutral'); break;
    case 'ArrowDown':  e.preventDefault(); openNegative(); break;
    case 'ArrowLeft':  e.preventDefault(); undo(); break;
  }
});

/* legend buttons clickable too */
document.querySelectorAll('.key').forEach(k=>{
  k.onclick = ()=>{
    const a = k.dataset.act;
    if(a==='up') advance('positive','up','Positive');
    if(a==='right') advance('neutral','right','Neutral');
    if(a==='down') openNegative();
    if(a==='left') undo();
  };
});

render();
</script>
</body>
</html>
